# cp .env.example .env して実機に合わせて編集する。
#
# *_DEVICE は必ず書く。それ以外の既定値は compose.yaml と Makefile 側にあるので、
# **実機と違うものだけ**書けば足ります。理由や背景は README を参照。

# ★ 実機では必ず確認すること: getent group dialout
DIALOUT_GID=20

# ★ 機体ごとのデバイス。ホストの /dev/serial/by-id/ のパスを書く (必須。既定値は無い)。
#   `make serial-ids` の出力からコピーする。下は形の例で、末尾のシリアルは機体ごとに違う。
#   1a86_*               : WaveShare のサーボバス基板 (ベースとアームで同じ型番)
#   Silicon_Labs_CP2102_* : RPLIDAR。★ 末尾が 0001 のままなら先にシリアルを書き換える
#                          (README.md の 3 章)。全個体が 0001 で区別できない
#   /dev/lekiwi や /dev/rplidar は書かないこと。共用機では他の機体を指していることがある。
#
#   split         : LEKIWI_DEVICE と SO101_DEVICE の2本 + RPLIDAR_DEVICE
#   shared / base : LEKIWI_DEVICE だけ + RPLIDAR_DEVICE
#   (base = アーム無し専用機。SO101_DEVICE は空のままでよい)
#
#   コンテナの中ではいつも /dev/lekiwi /dev/so101_follower /dev/rplidar に見える。
LEKIWI_DEVICE=/dev/serial/by-id/usb-1a86_USB_Single_Serial_XXXXXXXXXX-if00
SO101_DEVICE=
RPLIDAR_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_XXXX-if00-port0

# ★ 1 台の PC に機体を複数繋いで交互に動かすときは、上の 3 つの代わりに
#   末尾に _<名前> を付けて機体ごとに書き、`make up-base ROBOT=<名前>` で選ぶ。
#   選んだ機体は docker/robot/.robot に残り、以降の make は ROBOT を付けなくてよい。
#   コンテナ名と compose のプロジェクト名は robot-<名前> になる。
#   ROS_DOMAIN_ID_<名前> / MAP_DIR_<名前> は任意 (無ければ下の共通の値)。
# LEKIWI_DEVICE_1=/dev/serial/by-id/usb-1a86_USB_Single_Serial_XXXXXXXXXX-if00
# RPLIDAR_DEVICE_1=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_rplidar-1-if00-port0
# LEKIWI_DEVICE_2=/dev/serial/by-id/usb-1a86_USB_Single_Serial_YYYYYYYYYY-if00
# RPLIDAR_DEVICE_2=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_rplidar-2-if00-port0

# 地図の保存先（ホスト側）
MAP_DIR=${HOME}/maps

# ★ network_mode: host なので、既定の 0 のままだと同じ LAN の別マシンや
#   別スタックと /robot_description や /tf が混信します。
ROS_DOMAIN_ID=7

# ── 以下は既定のままでよいもの。変えたいときだけ書き足す ──────────────
#
#   ROS_LOCALHOST_ONLY            1        （Jazzy では非推奨。後継は下）
#   ROS_AUTOMATIC_DISCOVERY_RANGE LOCALHOST
#   LIBGL_ALWAYS_SOFTWARE         1        RViz。X が無いホストでは 1 のまま
#   MOCK_START_RVIZ               false    make mock で RViz を出すか
#
#   WRIST_CAMERA                  true     ★ URDF にリンクを生やすかだけ。
#                                          false にしてもカメラのノードは止まりません
#                                          （止めるなら start_camera:=false）
#   WRIST_CAMERA_NAME             wrist_camera   ★ TF のフレーム名にもなります
#   WRIST_CAMERA_PARENT           gripper_link   ★ 接頭辞なしで書くこと（arm_ が前置される）
#   WRIST_CAMERA_FPS              6        640x480 の点群は 1 枚 4.9MB
#   WRIST_CAMERA_DECIMATION       2
#
#   WRIST_CAMERA_{X,Y,Z,ROLL,PITCH,YAW}
#       手首カメラの取付姿勢。**書かないのが既定**で、URDF の値が使われます
#       （URDF が唯一の情報源。ここに数値を書くと二重管理になります）。
#       ★ 実測値はまだありません。URDF の既定値は D405 + 公式ホルダ
#         前提の幾何計算値なので、絶対位置はまだ信用できません。
